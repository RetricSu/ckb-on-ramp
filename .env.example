FNN_RPC_URL=http://127.0.0.1:8227
# Optional. Standalone CCH RPC; defaults to FNN_RPC_URL when CCH runs in-process.
CCH_RPC_URL=
CORS_ORIGIN=http://localhost:5173
CCH_BASE_FEE_SATS=100
CCH_FEE_RATE_PPM=3000
VITE_API_BASE_URL=http://localhost:3001/api
# Local offckb e2e: skip the operator CKB dust gift (devnet accounts are pre-funded).
SKIP_CAPACITY_GIFT=

# Scheme B Phase-1 Operator CKB Capacity Gift & Channel Funding
# 32-byte hex private key for operator CKB capacity gifts (never commit or expose)
OPERATOR_CKB_PRIVATE_KEY=
# Optional CKB node RPC URL, defaults to public testnet (https://testnet.ckb.dev/rpc)
CKB_RPC_URL=https://testnet.ckb.dev/rpc
# cWBTC channel funding amount in raw units (default 100000000 = 1.0 cWBTC)
OPERATOR_CHANNEL_FUNDING_AMOUNT=100000000

